# 统一用 LF 存储，消除 Windows 下的 CRLF 警告
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.http   text eol=lf
*.json   text eol=lf

*.ps1    text eol=crlf
*.bat    text eol=crlf

*.jar    binary
*.png    binary
*.jpg    binary
